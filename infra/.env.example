# Copy thành .env trên EC2: cp .env.example .env
# KHÔNG commit file .env thật lên bất kỳ repo nào

# ── Đường dẫn tới workspace của self-hosted runner BE trên chính EC2 này ──
# (đường dẫn cố định do GitHub Actions checkout tạo ra, xem README-EC2.md §4)
BE_REPO_PATH=/home/ubuntu/actions-runner-be/_work/SU26_SEP490_G2_BE/SU26_SEP490_G2_BE

# FE_REPO_PATH và PUBLIC_API_URL đã BỎ (2026-08-08): frontend chuyển sang
# Cloudflare Pages, không còn service frontend trong docker-compose.yml.
# Nếu .env trên server còn 2 biến này thì cũng vô hại, chỉ là không ai đọc nữa.

# ── MySQL (RDS, đã có sẵn) ──
RDS_ENDPOINT=your-rds-instance.xxxxxxxxxx.ap-southeast-1.rds.amazonaws.com
RDS_DATABASE=su26_sep490_g2
RDS_USERNAME=admin
RDS_PASSWORD=change_me_strong_password

# ── MinIO ──
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_password

# Hostname công khai phục vụ ảnh, do Caddy reverse_proxy về localhost:9000.
# KHÔNG có https:// và KHÔNG có dấu / ở cuối — docker-compose.yml dùng biến này
# cho cả MINIO_ENDPOINT lẫn extra_hosts (extra_hosts chỉ nhận hostname trần).
MINIO_PUBLIC_HOST=cdn.biliardtournament.cloud

# ── Các biến khác backend cần (JWT, mail, PayOS, Facebook...) ──
# copy từ .env.example của repo BE và điền giá trị prod thật
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=

# Dùng cho link trong email tự động + CORS. Phải là domain FE thật, có https://
FRONTEND_BASE_URL=https://biliardtournament.cloud
CORS_ALLOWED_ORIGIN=https://biliardtournament.cloud

# ── CORS nhiều origin ──
# application-prod.yml khai app.cors.allowed-origin-patterns là list CHỈ MỘT phần tử
# (lấy từ CORS_ALLOWED_ORIGIN ở trên), nên KHÔNG nhét nhiều domain bằng dấu phẩy được.
#
# Muốn nhiều origin thì dùng dạng chỉ số dưới đây. Spring không merge collection giữa
# các nguồn cấu hình — nguồn ưu tiên cao hơn (biến môi trường) GHI ĐÈ toàn bộ list,
# nên phải liệt kê lại đầy đủ, kể cả domain chính.
#
# Dùng allowedOriginPatterns (xem CorsConfig) nên hỗ trợ ký tự * — cần cho preview
# deployment của Cloudflare Pages, mỗi PR sinh một URL *.pages.dev khác nhau.
APP_CORS_ALLOWEDORIGINPATTERNS_0=https://biliardtournament.cloud
APP_CORS_ALLOWEDORIGINPATTERNS_1=https://www.biliardtournament.cloud
APP_CORS_ALLOWEDORIGINPATTERNS_2=https://*.pages.dev

# ── PayOS ──
# Thiếu 2 biến này thì sau khi thanh toán PayOS đá người dùng về localhost:3000.
# Đường dẫn /payment/success và /payment/cancel phải khớp routes.js của FE.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://biliardtournament.cloud/payment/success
PAYOS_CANCEL_URL=https://biliardtournament.cloud/payment/cancel

# ── MySQL trong Docker (CHƯA DÙNG — chỉ cần khi bật docker-compose.mysql.yml) ──
# Xem đầu file docker-compose.mysql.yml để biết đánh đổi trước khi bật.
# Sinh mật khẩu mạnh: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=su26_sep490_g2
MYSQL_APP_USER=btms_app
MYSQL_APP_PASSWORD=
