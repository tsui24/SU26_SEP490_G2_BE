# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database ─────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/su26_sep490_g2?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ── JWT ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=your_base64_secret_here
JWT_EXPIRATION_MS=86400000

# ── Mail (Gmail SMTP) ───────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=Giải đấu Bi-a BTMS
MAIL_SUPPORT_EMAIL=support@btms.vn
MAIL_APP_NAME=BTMS
FRONTEND_BASE_URL=https://biliardtournament.cloud

# ── Spring Profile ──────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── External API ────────────────────────────────────────
EXTERNAL_API_BASE_URL=http://localhost:8081

# ── MinIO (object storage — ảnh) ─────────────────────────
# Console: http://localhost:9001 | API: http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET=sep490-images
MINIO_SECURE=false
MINIO_DEFAULT_FOLDER=images
MINIO_MAX_FILE_SIZE_BYTES=5242880
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# ── PayOS ─────────────────────────────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Facebook Graph API ────────────────────────────────────
# Page ID: lấy từ Graph API Explorer → GET /me/accounts
FB_PAGE_ID=123456789012345

# Token: System User Token hoặc Page Access Token
# Xem hướng dẫn bên dưới để chọn mode phù hợp
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxx...

# App ID & Secret: cần cho exchange token (Mode 2)
# Lấy từ: developers.facebook.com → App → Settings → Basic
FB_APP_ID=
FB_APP_SECRET=

# Mode token:
#   true  = FB_PAGE_ACCESS_TOKEN là System User Token (khuyên dùng, không hết hạn)
#   false = FB_PAGE_ACCESS_TOKEN là Page Token trực tiếp
FB_USE_SYSTEM_USER=false

# API version (mặc định v21.0, đổi khi Meta ra version mới)
FB_API_VERSION=v21.0

# ── CORS (prod) — phân tách bằng dấu phẩy nếu nhiều domain
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
